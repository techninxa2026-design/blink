
/* =========================================
   BLINK AUTHENTICATION PAGES
   Brand: #FB6C00
========================================= */

.auth-page {
  min-height: 100vh;
  background: var(--page-bg);
  color: var(--text);
}

.site-header {
  width: min(1320px, 100%);
  height: 92px;
  padding: 0 56px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
}

.brand-logo {
  display: block;
  width: 126px;
  height: auto;
  object-fit: contain;
}

.theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 11px 17px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--card-bg);
  color: var(--text);
  font-size: 13px;
  font-weight: 600;
  transition: border-color 160ms ease, background 160ms ease;
}

.theme-toggle:hover {
  border-color: var(--brand);
}

.auth-layout {
  width: min(1220px, 100%);
  min-height: calc(100vh - 92px);
  padding: 26px 56px 64px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(390px, 470px);
  align-items: center;
  gap: clamp(48px, 8vw, 120px);
}

/* Left side */

.auth-hero {
  position: relative;
  min-width: 0;
  padding: 12px 0 20px;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0 0 27px;
  color: var(--brand);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2.3px;
}

.eyebrow-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  flex: 0 0 8px;
  border-radius: 50%;
  background: var(--brand);
}

.auth-hero h1 {
  margin: 0;
  color: var(--text);
  font-size: clamp(46px, 5vw, 70px);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -3px;
}

.auth-hero h1 span {
  color: var(--brand);
}

.hero-description {
  max-width: 460px;
  margin: 24px 0 0;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.9;
}

.hero-art {
  position: relative;
  width: min(100%, 390px);
  height: 245px;
  margin: 24px auto 8px;
}

.art-orbit {
  position: absolute;
  inset: 20px 38px;
  border: 1px dashed rgba(251, 108, 0, 0.25);
  border-radius: 50%;
  transform: rotate(-14deg);
}

.moment-card {
  position: absolute;
  overflow: hidden;
  border: 5px solid var(--card-bg);
  border-radius: 24px;
  box-shadow: var(--shadow);
}

.moment-card-back {
  top: 18px;
  right: 30px;
  width: 150px;
  height: 184px;
  background: linear-gradient(155deg, #ffc18b, #fb6c00);
  transform: rotate(10deg);
}

.moment-sun {
  position: absolute;
  top: 27px;
  right: 25px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #fff0c7;
}

.moment-mountains {
  position: absolute;
  right: -15px;
  bottom: -15px;
  left: -15px;
  height: 105px;
  background: #d94e0b;
  clip-path: polygon(0 100%, 0 64%, 27% 18%, 44% 53%, 68% 0, 100% 61%, 100% 100%);
}

.moment-card-front {
  top: 48px;
  left: 35px;
  width: 218px;
  height: 166px;
  background: linear-gradient(145deg, #ffe1c5, #ffad68);
  transform: rotate(-7deg);
}

.moment-scene {
  position: absolute;
  inset: 0 0 35px;
  background: linear-gradient(180deg, #ffcc9e 0%, #fba76b 100%);
}

.person {
  position: absolute;
  bottom: 0;
  display: block;
  width: 35px;
  height: 77px;
  border-radius: 22px 22px 5px 5px;
  background: #52382e;
}

.person::before {
  position: absolute;
  top: -23px;
  left: 4px;
  width: 27px;
  height: 27px;
  border-radius: 50%;
  background: #bd7650;
  content: "";
}

.person-one {
  left: 18px;
  height: 64px;
  background: #75442f;
}

.person-two {
  left: 65px;
  height: 82px;
  background: #fb6c00;
}

.person-three {
  left: 112px;
  height: 70px;
  background: #67463a;
}

.person-four {
  left: 157px;
  height: 91px;
  background: #e36c32;
}

.moment-caption {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 9px;
  background: var(--card-bg);
  color: var(--text);
  font-size: 11px;
  font-weight: 700;
  text-align: center;
}

.art-spark {
  position: absolute;
  color: var(--brand);
  font-size: 29px;
}

.spark-one {
  top: 18px;
  left: 25px;
}

.spark-two {
  right: 4px;
  bottom: 27px;
  font-size: 24px;
}

.hero-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin: 12px 0 0;
  color: var(--muted);
  font-size: 12px;
}

/* Right side / form card */

.auth-panel {
  width: 100%;
  min-width: 0;
}

.auth-card {
  width: 100%;
  padding: 40px;
  border: 1px solid var(--border);
  border-radius: 24px;
  background: var(--card-bg);
  box-shadow: var(--shadow);
}

.form-eyebrow {
  margin: 0 0 12px;
  color: var(--brand);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
}

.auth-card h2 {
  margin: 0;
  color: var(--text);
  font-size: 31px;
  font-weight: 800;
  line-height: 1.25;
  letter-spacing: -1px;
}

.form-description {
  margin: 10px 0 29px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

.form-field {
  min-width: 0;
  margin-bottom: 20px;
}

.form-field label {
  display: block;
  margin-bottom: 9px;
  color: var(--text);
  font-size: 12px;
  font-weight: 700;
}

.form-field input {
  display: block;
  width: 100%;
  min-width: 0;
  height: 49px;
  padding: 0 14px;
  border: 1px solid var(--border);
  border-radius: 11px;
  outline: none;
  background: var(--input-bg);
  color: var(--text);
  font-size: 13px;
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

.form-field input::placeholder {
  color: var(--muted);
  opacity: 0.75;
}

.form-field input:focus {
  border-color: var(--brand);
  box-shadow: 0 0 0 3px rgba(251, 108, 0, 0.1);
}

.form-field small {
  display: block;
  margin-top: 7px;
  color: var(--muted);
  font-size: 11px;
}

.password-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.password-wrap input {
  padding-right: 66px;
}

.show-password {
  position: absolute;
  right: 11px;
  border: 0;
  padding: 7px;
  background: transparent;
  color: var(--brand);
  font-size: 12px;
  font-weight: 700;
}

.login-options {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  margin: 3px 0 25px;
  font-size: 12px;
}

.remember-option {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--muted);
  cursor: pointer;
}

.remember-option input {
  width: 15px;
  height: 15px;
  margin: 0;
  accent-color: var(--brand);
}

.text-link {
  border: 0;
  padding: 0;
  background: transparent;
  color: var(--brand);
  font-size: 12px;
  font-weight: 700;
}

.submit-button {
  display: flex;
  width: 100%;
  min-height: 50px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 0;
  border-radius: 12px;
  background: var(--brand);
  color: #ffffff;
  font-size: 14px;
  font-weight: 800;
  box-shadow: 0 7px 18px rgba(251, 108, 0, 0.2);
  transition: transform 160ms ease, background 160ms ease;
}

.submit-button:hover:not(:disabled) {
  background: #e96000;
  transform: translateY(-1px);
}

.submit-button:disabled {
  opacity: 0.65;
  cursor: wait;
}

.form-divider {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 23px 0;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
}

.form-divider span:first-child,
.form-divider span:last-child {
  height: 1px;
  flex: 1;
  background: var(--border);
}

.secondary-button {
  display: flex;
  width: 100%;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  padding: 10px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--card-bg);
  color: var(--text);
  font-size: 13px;
  font-weight: 700;
  transition: border-color 160ms ease, color 160ms ease;
}

.secondary-button:hover {
  border-color: var(--brand);
  color: var(--brand);
}

.form-message {
  margin: 0 0 16px;
  padding: 11px 13px;
  border-radius: 10px;
  font-size: 12px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.form-error {
  border: 1px solid #f3c5bf;
  background: #fff0ed;
  color: #b42318;
}

.form-success {
  border: 1px solid #b6e2c4;
  background: #eaf8ef;
  color: #187647;
}

:root[data-theme="dark"] .form-error {
  border-color: #703c35;
  background: #351f1c;
  color: #ffb4a9;
}

:root[data-theme="dark"] .form-success {
  border-color: #315d40;
  background: #1c3022;
  color: #a6e5b8;
}

.legal-copy {
  margin: 25px 0 0;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.9;
  text-align: center;
}

.legal-copy a {
  color: var(--brand);
  font-weight: 700;
  text-decoration: none;
}

.legal-copy a:hover {
  text-decoration: underline;
}

/* Signup layout shares the same components */
.signup-page .auth-card h2 {
  font-size: 29px;
}

/* Responsive layout */

@media (min-width: 1500px) {
  .auth-layout {
    gap: 130px;
  }
}

@media (max-width: 1050px) {
  .site-header {
    padding-inline: 32px;
  }

  .auth-layout {
    padding-inline: 32px;
    grid-template-columns: minmax(0, 1fr) minmax(350px, 430px);
    gap: 38px;
  }

  .auth-card {
    padding: 32px;
  }

  .auth-hero h1 {
    font-size: clamp(43px, 5vw, 58px);
    letter-spacing: -2px;
  }

  .hero-description {
    font-size: 14px;
  }
}

@media (max-width: 760px) {
  .site-header {
    height: 76px;
    padding-inline: 22px;
  }

  .brand-logo {
    width: 110px;
  }

  .theme-toggle {
    padding: 9px 12px;
    font-size: 12px;
  }

  .auth-layout {
    min-height: auto;
    padding: 24px 20px 42px;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }

  .auth-hero {
    padding: 4px 0 0;
  }

  .auth-hero .eyebrow {
    margin-bottom: 17px;
    font-size: 9px;
  }

  .auth-hero h1 {
    font-size: clamp(40px, 9vw, 56px);
    letter-spacing: -2px;
  }

  .hero-description {
    max-width: 490px;
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.75;
  }

  .hero-art {
    width: min(100%, 320px);
    height: 185px;
    margin-top: 4px;
    margin-bottom: 0;
    transform: scale(0.85);
    transform-origin: top center;
  }

  .hero-footer {
    margin-top: -12px;
  }

  .auth-card {
    padding: 29px 23px;
    border-radius: 20px;
  }

  .auth-card h2 {
    font-size: 27px;
  }

  .form-description {
    margin-bottom: 25px;
  }

  .form-field {
    margin-bottom: 18px;
  }
}

@media (max-width: 380px) {
  .auth-layout {
    padding-inline: 14px;
  }

  .auth-card {
    padding: 25px 17px;
  }

  .login-options {
    align-items: flex-start;
  }

  .auth-hero h1 {
    font-size: 39px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}

/* ============================
   BLINK HOME FEED
   ============================ */

.blink-home {
  --home-bg: #fffaf6;
  --home-surface: #ffffff;
  --home-text: #171717;
  --home-muted: #77716d;
  --home-border: #eee5de;
  --home-orange: #fb6c00;
  min-height: 100dvh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  color: var(--home-text);
  background: var(--home-bg);
  position: relative;
  overflow: hidden;
}

:root[data-theme='dark'] .blink-home {
  --home-bg: #101010;
  --home-surface: #191919;
  --home-text: #f8f5f2;
  --home-muted: #aaa19b;
  --home-border: #303030;
}

.blink-home button {
  font: inherit;
}

.home-header {
  min-height: 76px;
  padding: 0 clamp(18px, 4vw, 56px);
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  border-bottom: 1px solid var(--home-border);
  background: var(--home-surface);
  position: relative;
  z-index: 5;
}

.icon-button {
  border: 0;
  background: transparent;
  color: var(--home-text);
  width: 44px;
  height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  border-radius: 14px;
  position: relative;
}

.icon-button:hover {
  background: var(--home-bg);
}

.menu-button {
  justify-self: start;
  flex-direction: column;
  gap: 5px;
}

.menu-button span {
  height: 2px;
  width: 21px;
  background: currentColor;
  border-radius: 4px;
}

.home-brand {
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-brand img {
  width: 106px;
  max-height: 45px;
  object-fit: contain;
}

.inbox-button {
  justify-self: end;
  font-size: 25px;
}

.inbox-dot {
  position: absolute;
  top: 8px;
  right: 7px;
  width: 9px;
  height: 9px;
  border: 2px solid var(--home-surface);
  border-radius: 50%;
  background: var(--home-orange);
}

.home-feed {
  width: min(100% - 32px, 520px);
  margin: 0 auto;
  padding: 25px 0 22px;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  outline: none;
}

.feed-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 16px;
  margin: 0 2px 17px;
}

.feed-eyebrow {
  margin: 0 0 5px;
  color: var(--home-muted);
  font-size: 10px;
  letter-spacing: 1.6px;
  font-weight: 800;
}

.feed-heading h1 {
  font-size: clamp(27px, 4vw, 34px);
  line-height: 1.1;
  margin: 0;
  letter-spacing: -1.2px;
}

.feed-spark {
  color: var(--home-orange);
  font-size: 23px;
}

.feed-count {
  font-size: 12px;
  color: var(--home-muted);
  border: 1px solid var(--home-border);
  border-radius: 99px;
  padding: 7px 11px;
  margin-bottom: 2px;
}

.moment-card-home {
  flex: 1;
  min-height: 360px;
  max-height: min(64vh, 700px);
  position: relative;
  overflow: hidden;
  border-radius: 26px;
  isolation: isolate;
  background: #252525;
  box-shadow: 0 15px 42px #00000012;
  touch-action: pan-y;
}

.moment-cover,
.full-moment-view > img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.moment-cover {
  transition: filter 260ms ease, transform 450ms ease;
}

.moment-card-home:hover .moment-cover {
  transform: scale(1.015);
}

.moment-shade,
.full-moment-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    #00000080 0%,
    transparent 24%,
    transparent 54%,
    #000000b8 100%
  );
  pointer-events: none;
}

.moment-topline {
  position: absolute;
  top: 18px;
  left: 17px;
  right: 17px;
  display: flex;
  align-items: center;
  gap: 11px;
  color: white;
  z-index: 2;
}

.moment-avatar {
  flex: 0 0 43px;
  width: 43px;
  height: 43px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: white;
  font-size: 12px;
  font-weight: 800;
  background: linear-gradient(145deg, #ffb16d, #fb6c00 70%, #b74300);
  border: 2px solid #ffffffcc;
}

.moment-author {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}

.moment-author strong {
  font-size: 14px;
  font-weight: 750;
}

.moment-author span {
  color: #ffffffc9;
  font-size: 11px;
}

.moment-more {
  margin-left: auto;
  color: white;
  background: #0000001c;
  border: 0;
  font-size: 20px;
  letter-spacing: 2px;
  padding: 8px;
  cursor: pointer;
}

.moment-bottom {
  position: absolute;
  left: 21px;
  right: 21px;
  bottom: 22px;
  color: white;
  z-index: 2;
}

.moment-bottom > p {
  font-size: 16px;
  font-weight: 700;
  margin: 0 0 14px;
  text-shadow: 0 1px 10px #0008;
}

.moment-meta {
  display: flex;
  justify-content: space-between;
  color: #ffffffd9;
  font-size: 11px;
}

.moment-expand {
  position: absolute;
  z-index: 3;
  top: 74px;
  right: 18px;
  width: 38px;
  height: 38px;
  border-radius: 12px;
  color: white;
  background: #00000042;
  border: 1px solid #ffffff40;
  cursor: pointer;
  font-size: 21px;
}

.feed-edge {
  position: absolute;
  z-index: 4;
  top: 45%;
  width: 38px;
  height: 56px;
  display: grid;
  place-items: center;
  border: 1px solid #ffffff60;
  background: #00000027;
  color: white;
  font-size: 35px;
  border-radius: 13px;
  cursor: pointer;
  opacity: 0;
  transition: opacity 150ms ease;
}

.moment-card-home:hover .feed-edge,
.feed-edge:focus-visible {
  opacity: 1;
}

.feed-edge-left {
  left: 10px;
}

.feed-edge-right {
  right: 10px;
}

.moment-gated .moment-cover {
  filter: blur(13px) brightness(.67);
  transform: scale(1.08);
}

.moment-gated .moment-topline,
.moment-gated .moment-bottom {
  filter: blur(5px);
  opacity: .45;
}

.moment-gate {
  position: absolute;
  z-index: 3;
  inset: 0;
  padding: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: white;
}

.gate-icon {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  border: 1px solid #ffffff6b;
  background: #ffffff20;
  border-radius: 20px;
  font-size: 28px;
  margin-bottom: 17px;
}

.moment-gate h2 {
  font-size: clamp(22px, 4vw, 28px);
  line-height: 1.2;
  max-width: 320px;
  margin: 0 0 11px;
  letter-spacing: -.5px;
}

.moment-gate p {
  color: #ffffffdc;
  font-size: 13px;
  line-height: 1.6;
  max-width: 300px;
  margin: 0 0 22px;
}

.gate-button {
  border: 0;
  border-radius: 14px;
  padding: 13px 19px;
  background: var(--home-orange);
  color: white;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
  box-shadow: 0 8px 25px #fb6c0040;
}

.gate-button span {
  font-size: 19px;
  vertical-align: -1px;
  margin-right: 5px;
}

.moment-gate small {
  font-size: 10px;
  color: #ffffffa8;
  margin-top: 12px;
}

.feed-controls {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 19px;
  padding: 16px 0 7px;
}

.round-control {
  width: 33px;
  height: 33px;
  border: 1px solid var(--home-border);
  background: var(--home-surface);
  color: var(--home-text);
  border-radius: 50%;
  cursor: pointer;
  font-size: 17px;
}

.feed-dots {
  display: flex;
  align-items: center;
  gap: 8px;
}

.feed-dot {
  width: 7px;
  height: 7px;
  padding: 0;
  border: 0;
  border-radius: 99px;
  background: #cfc6bf;
  cursor: pointer;
  transition: width 180ms ease, background 180ms ease;
}

.feed-dot.active {
  width: 20px;
  background: var(--home-orange);
}

.swipe-hint {
  color: var(--home-muted);
  text-align: center;
  font-size: 11px;
  margin: 3px 0 0;
}

.swipe-hint span {
  color: var(--home-orange);
  padding: 0 5px;
  font-size: 15px;
}

.home-bottom-nav {
  position: sticky;
  bottom: 0;
  z-index: 6;
  min-height: 76px;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  align-items: center;
  padding: 6px max(14px, env(safe-area-inset-left)) max(6px, env(safe-area-inset-bottom));
  background: var(--home-surface);
  border-top: 1px solid var(--home-border);
}

.bottom-nav-item {
  width: 100%;
  height: 54px;
  border: 0;
  background: transparent;
  color: var(--home-text);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  border-radius: 17px;
}

.nav-symbol {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  font-size: 27px;
  font-weight: 600;
  border-radius: 15px;
  line-height: 1;
}

.bottom-nav-item.selected:not(.capture-nav) .nav-symbol {
  color: var(--home-orange);
  background: #fb6c0014;
}

.capture-nav .nav-symbol {
  width: 49px;
  height: 49px;
  color: white;
  background: var(--home-orange);
  border-radius: 50%;
  font-size: 32px;
  box-shadow: 0 6px 17px #fb6c0035;
}

.menu-backdrop {
  position: fixed;
  inset: 0;
  z-index: 10;
  border: 0;
  background: #00000055;
  cursor: default;
}

.home-drawer {
  position: fixed;
  z-index: 11;
  top: 0;
  bottom: 0;
  left: 0;
  width: min(320px, 86vw);
  padding: 25px 19px;
  display: flex;
  flex-direction: column;
  color: var(--home-text);
  background: var(--home-surface);
  box-shadow: 14px 0 45px #00000018;
  animation: drawer-enter 180ms ease-out;
}

@keyframes drawer-enter {
  from { transform: translateX(-18px); opacity: .5; }
  to { transform: translateX(0); opacity: 1; }
}

.drawer-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 28px;
}

.drawer-heading img {
  width: 100px;
  max-height: 45px;
  object-fit: contain;
}

.drawer-close {
  width: 36px;
  height: 36px;
  border: 1px solid var(--home-border);
  background: var(--home-bg);
  color: var(--home-text);
  border-radius: 50%;
  font-size: 24px;
  cursor: pointer;
}

.drawer-label {
  color: var(--home-muted);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
  margin: 0 0 10px 9px;
}

.home-drawer > button:not(.drawer-close) {
  display: flex;
  align-items: center;
  gap: 14px;
  text-align: left;
  border: 0;
  background: transparent;
  color: var(--home-text);
  border-radius: 12px;
  padding: 14px 11px;
  cursor: pointer;
  font-size: 18px;
}

.home-drawer > button span {
  font-size: 14px;
  font-weight: 650;
}

.home-drawer > button:hover {
  background: var(--home-bg);
}

.drawer-spacer {
  flex: 1;
}

.home-drawer .drawer-logout {
  color: var(--home-orange) !important;
}

.drawer-footnote {
  color: var(--home-muted);
  font-size: 11px;
  line-height: 1.6;
  margin: 15px 8px 0;
}

.home-toast {
  position: fixed;
  z-index: 20;
  left: 50%;
  bottom: calc(91px + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  width: max-content;
  max-width: calc(100vw - 32px);
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 12px 15px;
  background: var(--home-text);
  color: var(--home-surface);
  border-radius: 14px;
  box-shadow: 0 10px 35px #00000020;
  font-size: 12px;
}

.home-toast button {
  border: 0;
  background: transparent;
  color: inherit;
  font-size: 19px;
  cursor: pointer;
}

.home-signin-required {
  width: min(100% - 36px, 420px);
  margin: auto;
  text-align: center;
  padding: 45px 0;
}

.home-lock {
  width: 66px;
  height: 66px;
  display: grid;
  place-items: center;
  margin: 0 auto 18px;
  color: var(--home-orange);
  background: #fb6c0012;
  border-radius: 22px;
  font-size: 34px;
}

.home-signin-required h1 {
  font-size: 30px;
  margin: 0 0 10px;
}

.home-signin-required p {
  color: var(--home-muted);
  line-height: 1.7;
  margin: 0 0 24px;
}

.home-signin-required .submit-button {
  max-width: 280px;
  margin: 0 auto;
}

.full-moment-view {
  position: fixed;
  inset: 0;
  z-index: 30;
  overflow: hidden;
  background: #090909;
  color: white;
}

.full-moment-view > img {
  object-fit: contain;
  background: #090909;
}

.full-moment-shade {
  background: linear-gradient(#00000070, transparent 25%, transparent 65%, #00000080);
}

.full-moment-header {
  position: absolute;
  top: max(22px, env(safe-area-inset-top));
  left: 20px;
  right: 20px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.full-moment-header > button {
  margin-left: auto;
  width: 42px;
  height: 42px;
  border: 1px solid #ffffff60;
  border-radius: 50%;
  color: white;
  background: #00000035;
  font-size: 26px;
  cursor: pointer;
}

.full-moment-caption {
  position: absolute;
  left: 23px;
  right: 23px;
  bottom: 95px;
  font-weight: 750;
  font-size: 19px;
}

.full-moment-controls {
  position: absolute;
  bottom: max(25px, env(safe-area-inset-bottom));
  left: 20px;
  right: 20px;
  display: flex;
  justify-content: space-between;
}

.full-moment-controls button {
  border: 1px solid #ffffff65;
  border-radius: 14px;
  color: white;
  background: #ffffff1a;
  padding: 11px 15px;
  cursor: pointer;
}

@media (min-width: 850px) {
  .blink-home {
    min-height: 100vh;
  }

  .home-header {
    min-height: 82px;
  }

  .home-feed {
    width: min(100% - 48px, 540px);
    padding-top: 27px;
  }

  .moment-card-home {
    max-height: min(65vh, 720px);
  }
}

@media (max-width: 600px) {
  .home-header {
    min-height: 64px;
    padding: 0 13px;
  }

  .home-brand img {
    width: 88px;
  }

  .home-feed {
    width: calc(100% - 24px);
    padding: 18px 0 13px;
  }

  .feed-heading {
    margin-bottom: 13px;
  }

  .feed-heading h1 {
    font-size: 27px;
  }

  .moment-card-home {
    min-height: 330px;
    max-height: none;
    flex: 1;
    border-radius: 22px;
  }

  .moment-topline {
    top: 15px;
    left: 14px;
    right: 14px;
  }

  .moment-bottom {
    left: 17px;
    right: 17px;
    bottom: 19px;
  }

  .moment-gate {
    padding: 19px;
  }

  .moment-gate h2 {
    font-size: 23px;
  }

  .feed-controls {
    padding-top: 11px;
  }

  .home-bottom-nav {
    min-height: 69px;
  }

  .bottom-nav-item {
    height: 48px;
  }

  .nav-symbol {
    width: 39px;
    height: 39px;
    font-size: 25px;
  }

  .capture-nav .nav-symbol {
    width: 45px;
    height: 45px;
  }

  .swipe-hint {
    font-size: 10px;
  }

  .feed-edge {
    opacity: .85;
    width: 30px;
    height: 46px;
  }
}

@media (max-height: 740px) and (min-width: 601px) {
  .home-feed {
    padding-top: 14px;
    padding-bottom: 12px;
  }

  .feed-heading {
    margin-bottom: 10px;
  }

  .moment-card-home {
    min-height: 280px;
    max-height: 58vh;
  }

  .feed-controls {
    padding-top: 8px;
  }

  .swipe-hint {
    margin-top: 0;
  }

  .home-bottom-nav {
    min-height: 66px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .blink-home *,
  .blink-home *::before,
  .blink-home *::after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}
