generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MomentType {
  PUBLIC
  PRIVATE
}

enum IrlInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ExchangeKind {
  OFFER
  REQUEST
  ADVICE
  COLLABORATION
}

enum ExchangeStatus {
  OPEN
  CLOSED
}

enum ExchangeOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ======================================================
// USER
// ======================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phoneNumber  String   @unique
  passwordHash String
  avatarKey    String?
  bio          String?  @db.VarChar(300)
  coverKey     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Connections
  businessChatMessages      BusinessChatMessage[] @relation("BusinessChatSender")
  businessMeetingsOrganized BusinessMeeting[]     @relation("BusinessMeetingOrganizer")
  businessMeetingsInvited   BusinessMeeting[]     @relation("BusinessMeetingAttendee")
  sentRequests              FriendRequest[]       @relation("SentRequests")
  receivedRequests          FriendRequest[]       @relation("ReceivedRequests")

  friendshipsA Friendship[] @relation("FriendshipA")
  friendshipsB Friendship[] @relation("FriendshipB")

  // Moments
  moments         Moment[]         @relation("MomentSender")
  receivedMoments Moment[]         @relation("MomentRecipient")
  momentViews     MomentView[]
  momentComments  MomentComment[]
  momentBpGifts   MomentBpGift[]
  momentReactions MomentReaction[]

  // Main Inbox
  conversationMemberships ConversationMember[]
  messages                Message[]
  hiddenMessages          MessageHidden[]
  messageReactions        MessageReaction[]
  privateMessageViews     MessagePrivateView[]

  // Blocking
  blocksMade     UserBlock[] @relation("Blocker")
  blocksReceived UserBlock[] @relation("Blocked")

  // Check-ins
  checkin Checkin?

  // IRL
  irlPlans               IrlPlan[]       @relation("IrlPlanCreator")
  irlInterests           IrlInterest[]
  irlInvitationsReceived IrlInvitation[] @relation("IrlInvitationRecipient")

  // Blink Exchange
  exchangePosts          ExchangePost[]        @relation("ExchangePostAuthor")
  exchangeResponses      ExchangeResponse[]    @relation("ExchangeResponseAuthor")
  exchangeThreadsStarted ExchangeThread[]      @relation("ExchangeThreadRequester")
  exchangeChatMessages   ExchangeChatMessage[] @relation("ExchangeChatSender")

  // Blink Secrets and Hearts
  blinkPoints          Int                   @default(0)
  blinkSecretsCreated  BlinkSecret[]         @relation("BlinkSecretCreator")
  blinkSecretGuesses   BlinkSecretGuess[]
  blinkSecretRewards   BlinkSecretReward[]
  blinkSecretReactions BlinkSecretReaction[]

  heartThreadsSent     BlinkHeartThread[]  @relation("BlinkHeartSender")
  heartThreadsReceived BlinkHeartThread[]  @relation("BlinkHeartReceiver")
  heartMessages        BlinkHeartMessage[] @relation("BlinkHeartMessageAuthor")

  irlMessages IrlMessage[]

  // Business Match
  businessProfile          BusinessProfile?
  businessRequestsSent     BusinessConnectionRequest[] @relation("BusinessRequestSender")
  businessRequestsReceived BusinessConnectionRequest[] @relation("BusinessRequestReceiver")
}

// ======================================================
// FRIEND REQUESTS
// ======================================================

model FriendRequest {
  id         String              @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

// ======================================================
// FRIENDSHIPS
// ======================================================

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
}

// ======================================================
// MOMENTS
// ======================================================

model Moment {
  id          String     @id @default(cuid())
  senderId    String
  recipientId String?
  type        MomentType
  mediaKey    String
  caption     String?    @db.VarChar(500)
  createdAt   DateTime   @default(now())
  expiresAt   DateTime?

  sender    User  @relation("MomentSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User? @relation("MomentRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  views     MomentView[]
  comments  MomentComment[]
  bpGifts   MomentBpGift[]
  reactions MomentReaction[]

  @@index([senderId, type, createdAt])
  @@index([recipientId, type, createdAt])
  @@index([expiresAt])
}

// ======================================================
// MOMENT VIEWS
// ======================================================

model MomentView {
  id        String   @id @default(cuid())
  momentId  String
  viewerId  String
  viewedAt  DateTime @default(now())
  expiresAt DateTime

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  viewer User   @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([momentId, viewerId])
  @@index([viewerId, expiresAt])
}

// ======================================================
// MOMENT COMMENTS
// ======================================================

model MomentComment {
  id        String   @id @default(cuid())
  momentId  String
  authorId  String
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([momentId, createdAt])
  @@index([authorId])
}

// ======================================================
// MOMENT BP GIFTS
// ======================================================

model MomentBpGift {
  id        String   @id @default(cuid())
  momentId  String
  senderId  String
  amount    Int
  createdAt DateTime @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([momentId, createdAt])
  @@index([senderId, createdAt])
}

// ======================================================
// MOMENT REACTIONS — CORRECTED
// ======================================================

model MomentReaction {
  id        String   @id @default(cuid())
  momentId  String
  userId    String
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId])
  @@index([momentId, emoji])
}

// ======================================================
// MAIN MESSENGER
// ======================================================

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]

  pinnedMessageId String?
  isGroup         Boolean @default(false)
  groupName       String? @db.VarChar(80)
  groupOwnerId    String?
}

model ConversationMember {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?
  muted          Boolean   @default(false)
  clearedAt      DateTime?
  role           String    @default("MEMBER")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// ======================================================
// MESSAGES
// ======================================================

model Message {
  id              String    @id @default(cuid())
  conversationId  String
  senderId        String
  body            String?   @db.Text
  mediaKey        String?
  mediaType       String?
  mediaMime       String?
  isPrivate       Boolean   @default(false)
  privateOpenedAt DateTime?
  createdAt       DateTime  @default(now())
  editedAt        DateTime?
  unsentAt        DateTime?
  replyToId       String?
  forwarded       Boolean   @default(false)

  hiddenBy     MessageHidden[]
  reactions    MessageReaction[]
  privateViews MessagePrivateView[]

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([replyToId])
}

model MessageHidden {
  messageId String
  userId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model MessageReaction {
  messageId String
  userId    String
  emoji     String @db.VarChar(16)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model MessagePrivateView {
  messageId String
  userId    String
  openedAt  DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

// ======================================================
// USER BLOCKING
// ======================================================

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// ======================================================
// CHECK-INS
// ======================================================

model Checkin {
  id        String    @id @default(cuid())
  userId    String    @unique
  emoji     String    @db.VarChar(16)
  status    String    @db.VarChar(80)
  note      String?   @db.VarChar(280)
  duration  String    @db.VarChar(16)
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("checkin")
}

// ======================================================
// IRL PLANS
// ======================================================

model IrlPlan {
  id          String   @id @default(cuid())
  creatorId   String
  title       String   @db.VarChar(120)
  category    String   @db.VarChar(32)
  description String?  @db.VarChar(1000)
  place       String?  @db.VarChar(180)
  meetupLat   Float?
  meetupLng   Float?
  meetupUrl   String?  @db.VarChar(2048)
  startsAt    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User @relation("IrlPlanCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  interests   IrlInterest[]
  invitations IrlInvitation[]
  messages    IrlMessage[]

  @@index([creatorId, startsAt])
  @@index([startsAt])
}

model IrlInterest {
  id        String   @id @default(cuid())
  planId    String
  userId    String
  reply     String   @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan IrlPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
  @@index([userId])
}

model IrlInvitation {
  id          String              @id @default(cuid())
  planId      String
  recipientId String
  status      IrlInvitationStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  plan      IrlPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipient User    @relation("IrlInvitationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([planId, recipientId])
  @@index([recipientId, status, createdAt])
}

// ======================================================
// BLINK EXCHANGE POSTS
// ======================================================

model ExchangePost {
  id          String         @id @default(cuid())
  authorId    String
  title       String         @db.VarChar(140)
  description String         @db.Text
  kind        ExchangeKind
  status      ExchangeStatus @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  author User @relation("ExchangePostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  media     ExchangeMedia[]
  responses ExchangeResponse[]
  threads   ExchangeThread[]

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([authorId, createdAt])
}

// ======================================================
// EXCHANGE MEDIA
// ======================================================

model ExchangeMedia {
  id       String @id @default(cuid())
  postId   String
  key      String @unique @db.VarChar(100)
  mimeType String @db.VarChar(60)
  position Int    @default(0)

  post ExchangePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
}

// ======================================================
// EXCHANGE RESPONSES
// ======================================================

model ExchangeResponse {
  id             String    @id @default(cuid())
  postId         String
  authorId       String
  message        String    @db.VarChar(600)
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  post   ExchangePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User         @relation("ExchangeResponseAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}

// ======================================================
// EXCHANGE THREADS
// ======================================================

model ExchangeThread {
  id          String   @id @default(cuid())
  postId      String
  requesterId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post ExchangePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  requester User @relation("ExchangeThreadRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  messages ExchangeChatMessage[]

  priceOffer ExchangePriceOffer?

  @@unique([postId, requesterId])
  @@index([requesterId, updatedAt])
}

// ======================================================
// EXCHANGE CHAT MESSAGES
// ======================================================

model ExchangeChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  text      String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  thread ExchangeThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User           @relation("ExchangeChatSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// ======================================================
// EXCHANGE PRICE OFFERS
// ======================================================

model ExchangePriceOffer {
  id       String @id @default(cuid())
  threadId String @unique

  amount Decimal @db.Decimal(18, 2)

  currency String @db.VarChar(3)

  status ExchangeOfferStatus @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  decidedAt DateTime?

  thread ExchangeThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ======================================================
// BLINK SECRETS
// ======================================================

enum BlinkSecretVisibility {
  ANONYMOUS
  NAMED
}

model BlinkSecret {
  id           String                @id @default(cuid())
  creatorId    String
  prompt       String                @db.VarChar(500)
  options      Json
  correctIndex Int
  visibility   BlinkSecretVisibility @default(ANONYMOUS)
  revealAt     DateTime
  createdAt    DateTime              @default(now())
  editedAt     DateTime?

  creator User @relation("BlinkSecretCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  guesses   BlinkSecretGuess[]
  rewards   BlinkSecretReward[]
  reactions BlinkSecretReaction[]

  @@index([createdAt])
  @@index([revealAt])
  @@index([creatorId, createdAt])
}

model BlinkSecretGuess {
  id            String   @id @default(cuid())
  secretId      String
  userId        String
  selectedIndex Int
  createdAt     DateTime @default(now())

  secret BlinkSecret @relation(fields: [secretId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([secretId, userId])
  @@index([userId])
}

model BlinkSecretReward {
  secretId  String
  userId    String
  points    Int      @default(10)
  createdAt DateTime @default(now())

  secret BlinkSecret @relation(fields: [secretId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([secretId, userId])
  @@index([userId])
}

model BlinkSecretReaction {
  secretId  String
  userId    String
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now())

  secret BlinkSecret @relation(fields: [secretId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([secretId, userId])
}

// ======================================================
// BLINK HEARTS
// ======================================================

enum BlinkHeartStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model BlinkHeartThread {
  id             String           @id @default(cuid())
  senderId       String
  receiverId     String
  status         BlinkHeartStatus @default(PENDING)
  senderRevealed Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  sender   User @relation("BlinkHeartSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("BlinkHeartReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  messages BlinkHeartMessage[]

  @@unique([senderId, receiverId])
  @@index([receiverId, updatedAt])
  @@index([senderId, updatedAt])
}

model BlinkHeartMessage {
  id        String    @id @default(cuid())
  threadId  String
  authorId  String
  text      String    @db.VarChar(2000)
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  thread BlinkHeartThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User             @relation("BlinkHeartMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// ======================================================
// IRL MESSAGES
// ======================================================

model IrlMessage {
  id        String   @id @default(cuid())
  planId    String
  senderId  String
  text      String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  plan   IrlPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sender User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
  @@index([senderId])
}

// ======================================================
// BUSINESS MATCH
// ======================================================

enum BusinessProfileType {
  PROFESSIONAL
  COMPANY
}

model BusinessProfile {
  id         String              @id @default(cuid())
  userId     String              @unique
  type       BusinessProfileType @default(PROFESSIONAL)
  name       String              @db.VarChar(100)
  headline   String              @db.VarChar(120)
  industry   String              @db.VarChar(80)
  location   String              @default("") @db.VarChar(100)
  skills     String              @default("") @db.VarChar(240)
  about      String              @default("") @db.VarChar(600)
  lookingFor String              @default("") @db.VarChar(400)
  active     Boolean             @default(false)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([active, type])
  @@index([active, industry])
}

// ======================================================
// BUSINESS CONNECTION REQUESTS
// ======================================================

enum BusinessConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model BusinessConnectionRequest {
  id         String                   @id @default(cuid())
  senderId   String
  receiverId String
  status     BusinessConnectionStatus @default(PENDING)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  messages BusinessChatMessage[]
  meetings BusinessMeeting[]

  sender   User @relation("BusinessRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("BusinessRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
}

// ======================================================
// BUSINESS CHAT MESSAGES
// ======================================================

model BusinessChatMessage {
  id           String   @id @default(cuid())
  connectionId String
  senderId     String
  text         String   @db.VarChar(2000)
  createdAt    DateTime @default(now())

  connection BusinessConnectionRequest @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sender     User                      @relation("BusinessChatSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt, id])
  @@index([senderId])
}

// ======================================================
// BUSINESS MEETINGS
// ======================================================

enum BusinessMeetingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

model BusinessMeeting {
  id           String                @id @default(cuid())
  connectionId String
  organizerId  String
  attendeeId   String
  title        String                @db.VarChar(120)
  agenda       String                @default("") @db.VarChar(1000)
  location     String                @default("") @db.VarChar(300)
  startsAt     DateTime
  endsAt       DateTime
  status       BusinessMeetingStatus @default(PENDING)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  connection BusinessConnectionRequest @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  organizer  User                      @relation("BusinessMeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  attendee   User                      @relation("BusinessMeetingAttendee", fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([organizerId, startsAt])
  @@index([attendeeId, startsAt])
  @@index([connectionId, startsAt])
}
